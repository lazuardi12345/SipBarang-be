generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  DIREKTUR
  SUPERADMIN
}

enum DeliveryOrderStatus {
  DRAFT
  PLANNING
  MENUNGGU_ACC
  MENUNGGU_APPROVAL
  DISETUJUI
  APPROVED
  DITOLAK
  REJECTED
  DALAM_PENGIRIMAN
  MENUNGGU_KONFIRMASI
  TERKIRIM
  DIKIRIM
  SELESAI
  DIBATALKAN
}

enum InvoiceStatus {
  BELUM_LUNAS
  LUNAS
  DIBATALKAN
}

model User {
  id           String   @id @default(uuid()) @db.VarChar(64)
  nama         String   @db.VarChar(150)
  email        String   @unique @db.VarChar(150)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         UserRole @default(ADMIN)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Tarif {
  id              String   @id @default(uuid()) @db.VarChar(64)
  areaDistribusi  String   @map("area_distribusi") @db.VarChar(200)
  tujuanKirim     String   @map("tujuan_kirim") @db.VarChar(200)
  total           Decimal  @db.Decimal(15, 2)
  totalSetelahPPh Decimal  @map("total_setelah_pph") @db.Decimal(15, 2)
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("tarifs")
}

model DeliveryOrder {
  id                  String                   @id @default(uuid()) @db.VarChar(64)
  noDo                String                   @map("no_do") @db.VarChar(100)
  tanggalKirim        DateTime?                @map("tanggal_kirim")
  status              DeliveryOrderStatus      @default(DRAFT)
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")

  // master ringkas, domain detail dipisah ke relasi
  tarifId             String?                  @map("tarif_id") @db.VarChar(64)
  areaDistribusi      String?                  @map("area_distribusi") @db.VarChar(200)
  tujuanKirim         String?                  @map("tujuan_kirim") @db.VarChar(200)
  biayaEkspedisi      Decimal                  @default(0) @map("biaya_ekspedisi") @db.Decimal(15, 2)
  itemsBarang         Json?                    @map("items_barang")
  namaBarang          String?                  @map("nama_barang") @db.Text
  jumlahKoli          Int                      @default(0) @map("jumlah_koli")
  totalNilaiBarang    Decimal                  @default(0) @map("total_nilai_barang") @db.Decimal(15, 2)
  beratBarangKg       Decimal                  @default(0) @map("berat_barang_kg") @db.Decimal(10, 2)
  catatanBarang       String?                  @map("catatan_barang") @db.Text
  dibuatOleh          Json?                    @map("dibuat_oleh")

  schedule            DeliveryOrderSchedule?
  document            DeliveryOrderDocument?
  approvals           DeliveryOrderApproval[]
  reports             DeliveryOrderReport[]
  confirmations      DeliveryOrderConfirmation[]
  histories           DeliveryOrderHistory[]
  invoice             Invoice?

  @@index([status])
  @@index([noDo])
  @@map("delivery_orders")
}

model DeliveryOrderSchedule {
  id                  String         @id @default(uuid()) @db.VarChar(64)
  orderId             String         @unique @map("order_id") @db.VarChar(64)
  order               DeliveryOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  noSchedule          String?        @map("no_schedule") @db.VarChar(100)
  tglSchedule         DateTime?      @map("tgl_schedule") @db.Date
  tipeMobilRit        String?        @map("tipe_mobil_rit") @db.VarChar(100)
  gudangAsal          String?        @map("gudang_asal") @db.VarChar(200)
  namaSupir           String?        @map("nama_supir") @db.VarChar(150)
  noHpSupir           String?        @map("no_hp_supir") @db.VarChar(30)
  noPolisiKendaraan   String?        @map("no_polisi_kendaraan") @db.VarChar(30)
  jenisKendaraan      String?        @map("jenis_kendaraan") @db.VarChar(100)
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  @@map("delivery_order_schedules")
}

model DeliveryOrderDocument {
  id                    String        @id @default(uuid()) @db.VarChar(64)
  orderId               String        @unique @map("order_id") @db.VarChar(64)
  order                 DeliveryOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  noDocPerusahaan       String?       @map("no_doc_perusahaan") @db.VarChar(100)
  tglDocPerusahaan      DateTime?     @map("tgl_doc_perusahaan") @db.Date
  namaToko              String?       @map("nama_toko") @db.VarChar(200)
  salesman              String?       @db.VarChar(150)
  agen                 String?       @default("TBN") @db.VarChar(100)
  kota                 String?       @db.VarChar(100)
  kecamatan            String?       @db.VarChar(100)
  alamatLengkapTujuan  String?       @map("alamat_lengkap_tujuan") @db.Text
  noHpPenerima         String?       @map("no_hp_penerima") @db.VarChar(30)
  keteranganDoc        String?       @map("keterangan_doc") @db.Text
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  @@map("delivery_order_documents")
}

model DeliveryOrderApproval {
  id            String        @id @default(uuid()) @db.VarChar(64)
  orderId       String        @map("order_id") @db.VarChar(64)
  order         DeliveryOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId        String        @map("user_id") @db.VarChar(64)
  action        String        @db.VarChar(30)
  note          String?       @db.Text
  createdAt     DateTime      @default(now()) @map("created_at")

  @@map("delivery_order_approvals")
}

model DeliveryOrderReport {
  id                   String        @id @default(uuid()) @db.VarChar(64)
  orderId              String        @map("order_id") @db.VarChar(64)
  order                DeliveryOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  namaPenerimaBarang   String?       @map("nama_penerima_barang") @db.VarChar(200)
  catatanPelaporan     String?       @map("catatan_pelaporan") @db.Text
  buktiPengirimanUrl   String?       @map("bukti_pengiriman_url") @db.Text
  tanggalDiterima      DateTime?     @map("tanggal_diterima")
  createdAt            DateTime      @default(now()) @map("created_at")

  @@map("delivery_order_reports")
}

model DeliveryOrderConfirmation {
  id                         String        @id @default(uuid()) @db.VarChar(64)
  orderId                    String        @map("order_id") @db.VarChar(64)
  order                      DeliveryOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId                     String        @map("user_id") @db.VarChar(64)
  catatanKonfirmasiDirektur  String?       @map("catatan_konfirmasi_direktur") @db.Text
  confirmedAt                DateTime?     @map("confirmed_at")
  createdAt                  DateTime      @default(now()) @map("created_at")

  @@map("delivery_order_confirmations")
}

model DeliveryOrderHistory {
  id          String        @id @default(uuid()) @db.VarChar(64)
  orderId     String        @map("order_id") @db.VarChar(64)
  order       DeliveryOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  oldStatus   String?       @map("old_status") @db.VarChar(50)
  newStatus   String        @map("new_status") @db.VarChar(50)
  changedBy   String?       @map("changed_by") @db.VarChar(64)
  note        String?       @db.Text
  createdAt   DateTime      @default(now()) @map("created_at")

  @@map("delivery_order_histories")
}

model Invoice {
  id             String       @id @default(uuid()) @db.VarChar(64)
  orderId        String?      @unique @map("order_id") @db.VarChar(64)
  order          DeliveryOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  noInvoice      String       @unique @map("no_invoice") @db.VarChar(100)
  tanggalInvoice DateTime     @map("tanggal_invoice")
  namaPelanggan  String       @map("nama_pelanggan") @db.VarChar(200)
  alamatPelanggan String?     @map("alamat_pelanggan") @db.Text
  noPoCustomer   String?      @map("no_po_customer") @db.VarChar(100)
  subtotal       Decimal      @db.Decimal(15, 2)
  totalPph2      Decimal      @default(0) @map("total_pph2") @db.Decimal(15, 2)
  totalTagihan   Decimal      @default(0) @map("total_tagihan") @db.Decimal(15, 2)
  status         InvoiceStatus @default(BELUM_LUNAS)
  dibuatOleh     Json?        @map("dibuat_oleh")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  items          InvoiceItem[]

  @@index([status])
  @@map("invoices")
}

model InvoiceItem {
  id               String   @id @default(uuid()) @db.VarChar(64)
  invoiceId        String   @map("invoice_id") @db.VarChar(64)
  invoice          Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  deliveryOrderId  String?  @map("delivery_order_id") @db.VarChar(64)
  noDO             String?  @map("no_do") @db.VarChar(100)
  noDocPerusahaan  String?  @map("no_doc_perusahaan") @db.VarChar(100)
  tglDocPerusahaan DateTime? @map("tgl_doc_perusahaan") @db.Date
  namaToko         String?  @map("nama_toko") @db.VarChar(200)
  areaDistribusi   String?  @map("area_distribusi") @db.VarChar(200)
  tujuanKirim      String?  @map("tujuan_kirim") @db.VarChar(200)
  tanggalKirim     DateTime? @map("tanggal_kirim")
  namaSupir        String?  @map("nama_supir") @db.VarChar(150)
  noPolisiKendaraan String? @map("no_polisi_kendaraan") @db.VarChar(80)
  namaBarang       String?  @map("nama_barang") @db.Text
  jumlahKoli       Int      @default(0) @map("jumlah_koli")
  biayaEkspedisi   Decimal  @default(0) @map("biaya_ekspedisi") @db.Decimal(15, 2)
  pph2             Decimal  @default(0) @db.Decimal(15, 2)
  totalSetelahPPh  Decimal  @default(0) @map("total_setelah_pph") @db.Decimal(15, 2)
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("invoice_items")
}
